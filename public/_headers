# Static-asset headers for the Cloudflare assets binding.
#
# Why this file exists (plan A7): the assets binding serves /_next/static/*
# directly, BEFORE the Worker runs, so next.config.ts `headers()` never sees
# those requests. Without this file the hashed bundles ship with no security
# headers at all — a silent parity regression against Vercel that no page-level
# check would catch. Keep the values identical to SECURITY_HEADERS in
# next.config.ts; if one side changes, change both.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# CapyBg's models and ORT runtime. Paths are content-addressed (model sha8,
# ORT version), so they are immutable; the security table matches the
# /_next/static/* block above — change one, change both.
/capybg/*
  Cache-Control: public, max-age=31536000, immutable
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# ...except the manifest: one fixed URL naming the current hashes. Marked
# immutable, a browser kept its first copy for a year and never learned of a
# new model (#71's group helper was "missing from the asset manifest").
/capybg/manifest.json
  ! Cache-Control
  Cache-Control: no-cache

# CapyRead's OCR engine and language files. Every file is pinned at build
# time (tesseract worker + LSTM cores + pdf.js worker from the locked
# node_modules versions; traineddata SHA-256-pinned in
# src/lib/capyread/langs.ts), so the paths are stable and the year is right;
# the security table matches the /_next/static/* block above — change one,
# change both. (The manifest here is build tooling only; the browser never
# fetches it, so unlike /capybg/manifest.json it needs no no-cache carve-out.)
/ocr/*
  Cache-Control: public, max-age=31536000, immutable
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
