{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "capytools",
  // Pinned deliberately. This project has two Cloudflare accounts under one
  // login, and `capytools.app` is a zone in THIS one. A Worker custom domain
  // requires the zone and the Worker in the same account, so a deploy that
  // lands in the other account can never serve the domain — and wrangler will
  // happily pick whichever account the current OAuth token covers. Pinning it
  // turns that silent mistake into a loud one.
  "account_id": "534618100df145137ec40616857d2055",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-17",
  // nodejs_compat: node:net.isIP in ssrf.ts rides this (A6) — do not drop.
  // global_fetch_strictly_public: replaces request-filtering-agent's
  // connect-time private-address refusal for the extract route (§7.1).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // The live domain. `custom_domain` makes Cloudflare create the proxied DNS
  // record and provision the certificate; the zone is already in this account.
  // capytools.app is an HSTS-preloaded TLD, so the certificate has to be valid
  // on the FIRST response — there is no http:// fallback to degrade to.
  "routes": [{ "pattern": "capytools.app", "custom_domain": true }],
  // Adding a route turns both of these OFF by default. Keep them: `workers_dev`
  // is the URL to exercise a deploy without pointing the live domain at it, and
  // `preview_urls` is what makes `wrangler versions upload` useful on PRs.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "capytools" }
  ],
  "observability": { "enabled": true }
}
