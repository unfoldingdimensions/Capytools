{
  "name": "capytools",
  "version": "0.1.0",
  "description": "A home for small, quiet tools. Eleven so far \u2014 all run in your browser and keep nothing.",
  "keywords": [
    "browser-tools",
    "client-side",
    "privacy",
    "local-first",
    "no-tracking",
    "exif-removal",
    "metadata-removal",
    "prompt-engineering",
    "github-stats",
    "nextjs",
    "react",
    "typescript",
    "tauri",
    "tailwindcss"
  ],
  "license": "Apache-2.0",
  "homepage": "https://capytools.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unfoldingdimensions/Capytools.git"
  },
  "bugs": {
    "url": "https://github.com/unfoldingdimensions/Capytools/issues"
  },
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --port 3024",
    "prebuild": "node scripts/generate-license-text.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare build && wrangler deploy --env-file .env.cloudflare",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts --env-file .env.cloudflare",
    "cf-clean": "powershell -NoProfile -Command \"Get-CimInstance Win32_Process -Filter \\\"Name='node.exe'\\\" | Where-Object { $_.CommandLine -match 'wrangler' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }; Get-Process -Name workerd,esbuild -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue\""
  },
  "dependencies": {
    "apca-w3": "0.1.9",
    "class-variance-authority": "^0.7.1",
    "client-zip": "^2.5.0",
    "clsx": "^2.1.1",
    "css-tree": "^3.2.1",
    "culori": "^4.0.2",
    "exifr": "^7.1.3",
    "html-to-image": "^1.11.13",
    "js-tiktoken": "^1.0.21",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "qr-code-styling": "^1.9.2",
    "qrcode-generator": "^1.5.2",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/culori": "^4.0.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "exceljs": "^4.4.0",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.134.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
