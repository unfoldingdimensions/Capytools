generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String                     @id @default(cuid())
  clerkUserId       String                     @unique
  email             String                     @unique
  firstName         String?
  lastName          String?
  profileImageUrl   String?
  phoneEncrypted    String?
  addressEncrypted  String?
  subscriptionTier  SubscriptionTier           @default(FREE)
  creditsRemaining  Int                        @default(3)
  creditsUsed       Int                        @default(0)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  lastLoginAt       DateTime?
  aiJobs            AIJobQueue[]
  atsScores         ATSScore[]
  featureUsage      FeatureUsage[]
  interviewSessions InterviewPracticeSession[]
  jobDescriptions   JobDescription[]
  payments          Payment[]
  resumes           Resume[]
  tailoredResumes   TailoredResume[]
  uploadedFiles     UploadedFile[]

  @@index([clerkUserId])
  @@index([email])
  @@map("users")
}

model Resume {
  id                      String                     @id @default(cuid())
  userId                  String
  title                   String                     @default("Untitled Resume")
  isPublic                Boolean                    @default(false)
  targetRoles             String[]                   @default([])
  personalInfoEncrypted   String?
  workExperienceEncrypted String?
  educationEncrypted      String?
  projectsEncrypted       String?
  skillsEncrypted         String?
  certificationsEncrypted String?
  customSectionsEncrypted String?
  templateId              String?
  customStyles            String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  lastAccessedAt          DateTime                   @default(now())
  atsScores               ATSScore[]
  exports                 Export[]
  interviewSessions       InterviewPracticeSession[]
  user                    User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tailoredResumes         TailoredResume[]

  @@index([userId])
  @@index([userId, updatedAt])
  @@map("resumes")
}

model UploadedFile {
  id                     String     @id @default(cuid())
  userId                 String
  originalFilename       String
  fileSize               Int
  mimeType               String
  storageUrl             String
  status                 FileStatus @default(PENDING)
  processingError        String?
  extractedDataEncrypted String?
  createdAt              DateTime   @default(now())
  processedAt            DateTime?
  user                   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@map("uploaded_files")
}

model Export {
  id           String       @id @default(cuid())
  resumeId     String
  format       ExportFormat
  fileUrl      String?
  fileSize     Int?
  status       ExportStatus @default(PENDING)
  errorMessage String?
  createdAt    DateTime     @default(now())
  completedAt  DateTime?
  resume       Resume       @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@index([resumeId, createdAt])
  @@map("exports")
}

model Payment {
  id                String          @id @default(cuid())
  userId            String
  amount            Float
  currency          String          @default("USD")
  provider          PaymentProvider
  providerPaymentId String          @unique
  status            PaymentStatus   @default(PENDING)
  description       String?
  metadata          String?
  creditsAdded      Int             @default(0)
  createdAt         DateTime        @default(now())
  completedAt       DateTime?
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerPaymentId])
  @@map("payments")
}

model RateLimit {
  id           String   @id @default(cuid())
  identifier   String
  endpoint     String
  requestCount Int      @default(1)
  windowStart  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([identifier, endpoint])
  @@index([identifier, endpoint, windowStart])
  @@map("rate_limits")
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String
  resource     String
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  metadata     String?
  success      Boolean  @default(true)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model JobDescription {
  id                String                     @id @default(cuid())
  userId            String
  title             String
  company           String
  description       String
  requirements      String[]                   @default([])
  responsibilities  String[]                   @default([])
  keywords          String[]                   @default([])
  experienceLevel   String?
  employmentType    String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  atsScores         ATSScore[]
  interviewSessions InterviewPracticeSession[]
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tailoredResumes   TailoredResume[]

  @@index([userId])
  @@index([userId, createdAt])
  @@map("job_descriptions")
}

model TailoredResume {
  id                    String         @id @default(cuid())
  userId                String
  originalResumeId      String
  jobDescriptionId      String
  reference             String         // Format: "Company Name - Role - Resume Name"
  tailoredDataEncrypted String
  changesEncrypted      String
  suggestionsEncrypted  String?
  atsScore              Float?
  matchScore            Float?
  createdAt             DateTime       @default(now())
  jobDescription        JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  originalResume        Resume         @relation(fields: [originalResumeId], references: [id], onDelete: Cascade)
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([originalResumeId])
  @@index([jobDescriptionId])
  @@index([reference])
  @@map("tailored_resumes")
}

model ATSScore {
  id                  String          @id @default(cuid())
  userId              String
  resumeId            String
  jobDescriptionId    String?
  reference           String?         // Format: "Company Name - Role - Resume Name"
  overallScore        Int
  formattingScore     Int
  keywordScore        Int
  experienceScore     Int
  educationScore      Int
  skillsScore         Int
  clarityScore        Int
  suggestions         String[]        @default([])
  missingKeywords     String[]        @default([])
  matchedRequirements Int             @default(0)
  createdAt           DateTime        @default(now())
  jobDescription      JobDescription? @relation(fields: [jobDescriptionId], references: [id])
  resume              Resume          @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resumeId])
  @@index([resumeId, createdAt])
  @@index([reference])
  @@map("ats_scores")
}

model InterviewPracticeSession {
  id               String          @id @default(cuid())
  userId           String
  resumeId         String
  jobDescriptionId String?
  reference        String?         // Format: "Company Name - Role - Resume Name"
  questions        Json
  createdAt        DateTime        @default(now())
  completedAt      DateTime?
  jobDescription   JobDescription? @relation(fields: [jobDescriptionId], references: [id])
  resume           Resume          @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resumeId])
  @@index([userId, createdAt])
  @@index([reference])
  @@map("interview_practice_sessions")
}

model AIJobQueue {
  id               String    @id @default(cuid())
  userId           String
  type             String
  status           String    @default("pending")
  progress         Int       @default(0)
  payloadEncrypted String
  resultEncrypted  String?
  errorMessage     String?
  retryCount       Int       @default(0)
  maxRetries       Int       @default(3)
  createdAt        DateTime  @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([createdAt])
  @@map("ai_job_queue")
}

model FeatureUsage {
  id         String   @id @default(cuid())
  userId     String
  feature    String
  usageCount Int      @default(1)
  lastUsedAt DateTime @default(now())
  metadata   String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature])
  @@index([userId])
  @@index([feature])
  @@map("feature_usage")
}

enum SubscriptionTier {
  FREE
  BASIC
  PREMIUM
  ENTERPRISE
}

enum FileStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ExportFormat {
  PDF
  DOCX
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}
